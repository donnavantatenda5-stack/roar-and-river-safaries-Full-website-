# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Restart `npm run dev` after editing it.

# Supabase: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Resend (server only - no NEXT_PUBLIC_ prefix!)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Until you verify your own domain in Resend, use onboarding@resend.dev
RESEND_FROM_EMAIL=Roar and River Safaris <onboarding@resend.dev>
# Where booking alerts are sent
BOOKING_NOTIFY_EMAIL=you@example.com

# WhatsApp: digits only, country code first (Zimbabwe = 263), no + or spaces.
# Leave empty and the "Book on WhatsApp" button opens the booking form instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
